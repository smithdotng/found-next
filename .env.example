# Copy to .env.local. Most values can be copied from ../.env (the Express app).

# Same MongoDB database as the Express app — users, listings and enquiries are shared.
MONGODB_URI=
# Any long random string. Signs the login cookie.
SESSION_SECRET=
# Public site address, used for OG tags, canonical URLs, sitemap and email links.
BASE_URL=https://found.ng

# Super admin (can send newsletters, email users, delete accounts, see all enquiries).
SUPERADMIN_EMAIL=admin@found.ng
# Where admin notification emails go (defaults to the email account below).
ADMIN_EMAIL=

# Hostinger SMTP (same as the Express app).
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional. Defaults to ../public/uploads so both apps share the same photos.
UPLOAD_DIR=

# Google Analytics (defaults to the existing G-H8R24Q91C0; set empty to disable).
# NEXT_PUBLIC_GA_ID=G-H8R24Q91C0
